# GrindOS — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# ─── Supabase (Leaderboard) ───────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ─── Administrative Whitelist ──────────────────────────────────────────────────
# Comma-separated list of emails with admin access
VITE_ADMIN_EMAILS=admin@grindos.dev

# ─── Stripe Monetization ───────────────────────────────────────────────────────
# Stripe Payment Link URL for $29 Lifetime Pro License checkout
VITE_STRIPE_PAYMENT_URL=https://buy.stripe.com/your-payment-link-here
